# Copy to .env and fill in. Never commit .env.

# Groq (default hosted LLM): https://console.groq.com/keys
GROQ_API_KEY=

# Gemini (fallback LLM + eval judge): https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Local Ollama (optional, 'data never leaves the plant' mode)
OLLAMA_BASE_URL=http://localhost:11434

# Optional cache locations (e.g. another drive)
HF_HOME=
UV_CACHE_DIR=

# Public demo: read-only + rate limited
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000

# Deployment only (scripts use these; the app ignores them)
# https://huggingface.co/settings/tokens  -> New token, type "Write"
HF_TOKEN=
# https://vercel.com/account/settings/tokens -> Create
VERCEL_TOKEN=
